# Copy to .env (never commit it). Every key below is read at startup; the app refuses to start on invalid values.

# Public HTTPS origin of this app, no path. Register PUBLIC_ORIGIN/auth/callback on the Fluxer application.
PUBLIC_ORIGIN=https://poker.example.com
# Origin of the Fluxer instance, no path. Endpoints are discovered from /.well-known/fluxer.
FLUXER_ORIGIN=https://chat.example.com
# Only members of this community may sign in.
FLUXER_GUILD_ID=1234567890123456789
# Optional: a text channel in that community. Grant the bot View Channel and Send Messages there.
# Leave empty to disable host posts and !pokerleaderboard. Keep channel membership private.
FLUXER_CHANNEL_ID=
# Enable the Fluxer Gateway for !pokernight and, with a private channel, !pokerleaderboard.
FLUXER_BOT_COMMANDS=false
# Bot token of the same application; the bot must be installed in the community.
FLUXER_BOT_TOKEN=replace-me
FLUXER_CLIENT_ID=1234567890123456789
FLUXER_CLIENT_SECRET=replace-me

# SQLite file. Compose sets /data/pokerbot.sqlite on the persistent volume; this value is for local runs.
DATABASE_PATH=./data/pokerbot.sqlite
# Session lifetime in seconds (300-604800, default 28800 = 8 hours).
SESSION_SECONDS=28800
# Trusted local use only: allow plain HTTP for localhost/private LAN PUBLIC_ORIGIN and an HTTP FLUXER_ORIGIN.
ALLOW_INSECURE_LOCAL=false
# Comma-separated reverse proxy IPs/CIDRs as seen by the container; empty ignores X-Forwarded-For. Never /0.
TRUSTED_PROXY_CIDRS=
